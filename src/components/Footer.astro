	<p>&copy; {year} Julian-adv</p>
	<a href="https://github.com/Julian-adv/OpenMMO" target="_blank" rel="noreferrer">OpenMMO on GitHub</a>
</footer>

<style>
	footer {
		padding: 2em 1em 6em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer p {
		margin-bottom: 0.5em;
	}
	footer a {
		color: rgb(var(--gray-dark));
	}
</style>
